[Unit]
Description=Attendance camera video and dashboard bridge
After=network-online.target attendance-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/attendance-camera
EnvironmentFile=%h/attendance-camera/local/transport.env
ExecStart=%h/attendance-camera/local/bin/attendance-bridge
Restart=always
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M
CPUQuota=100%
UMask=0077

[Install]
WantedBy=default.target
