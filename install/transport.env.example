# Vercel relay and PH bridge. Use the shared server's verified TLS hostname.
REDIS_URL=rediss://attendance:REPLACE_WITH_PROJECT_PASSWORD@redis.phack.sh:6379/0
REDIS_NAMESPACE=attendance:v1
# PH bridge only: private credential for the loopback Python API.
ATTENDANCE_TOKEN=REPLACE_WITH_EXISTING_INTERNAL_API_TOKEN

# Vercel only. CAMERA_TOKEN must differ from the organizer token.
PUBLIC_ORIGIN=https://attendance.purduehackers.com
CAMERA_TOKEN=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
PH_ID_CLIENT_ID=REPLACE_WITH_REGISTERED_CLIENT_ID
PH_ID_CLIENT_SECRET=REPLACE_WITH_REGISTERED_CLIENT_SECRET

# Pi publisher only; it does not receive Redis or organizer credentials.
CAMERA_RELAY_URL=wss://attendance.purduehackers.com/ingest
CAMERA_SOURCE=rtsp://127.0.0.1:8554/cam

# PH bridge only; these are the defaults.
ATTENDANCE_BACKEND=http://127.0.0.1:8000
BRIDGE_BIND=127.0.0.1:18555
