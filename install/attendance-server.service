[Unit]
Description=Purdue Hackers attendance camera backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/attendance-camera
EnvironmentFile=%h/attendance-camera/local/server.env
ExecStart=%h/attendance-camera/.venv/bin/attendance-server serve --config local/server.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/attendance-camera/local
MemoryMax=2G
CPUQuota=400%
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=2
Environment=MPLCONFIGDIR=%h/attendance-camera/local/cache/matplotlib

[Install]
WantedBy=default.target
