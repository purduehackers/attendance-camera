[Unit]
Description=Private attendance camera RTSP tunnel
After=network-online.target camera-feed.service
Wants=network-online.target
Requires=camera-feed.service
StartLimitIntervalSec=0

[Service]
User=__PI_USER__
ExecStart=/usr/bin/ssh -NT -p __SERVER_SSH_PORT__ -i __KEY_PATH__ -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o UserKnownHostsFile=__KNOWN_HOSTS_PATH__ -o StrictHostKeyChecking=yes -R 127.0.0.1:18554:__PI_TAILSCALE_IP__:8554 __SERVER_USER__@__SERVER_HOST__
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
