[Unit]
Description=Attendance camera authenticated video publisher
After=network-online.target camera-feed.service
Wants=network-online.target camera-feed.service

[Service]
Type=simple
User=hackers
EnvironmentFile=/etc/attendance-camera/publisher.env
ExecStart=/usr/local/bin/camera-publisher
Restart=always
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=192M
CPUQuota=100%
UMask=0077

[Install]
WantedBy=multi-user.target
